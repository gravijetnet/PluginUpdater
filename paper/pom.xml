<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.gravijet.pluginupdater</groupId>
        <artifactId>PluginUpdater</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>paper</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Core shared logic (will be shaded into this JAR) -->
        <dependency>
            <groupId>net.gravijet.pluginupdater</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>

        <!--
            Spigot API 1.8.8 — used for compilation only (provided at runtime by the server).
            We only use standard Bukkit/Spigot APIs (JavaPlugin, getFile(), etc.) so this
            is fully compatible with custom Paper 1.8.8 forks at runtime.
            Hosted on SpigotMC Nexus (publicly available, works in GitHub Actions).
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Paper 1.8.8 bundles Gson 2.2.4 (too old — JsonParser.parseString() requires 2.8.6+)
            and SnakeYAML 1.x (too old — LoaderOptions requires 2.0+).
            Shade and relocate both so we always use known-good versions regardless of what
            the server bundles, and to avoid classpath conflicts with the server's copies.
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Shade core + Gson + SnakeYAML; relocate to avoid conflicts
                                 with the server's bundled (older) copies of these libraries. -->
                            <artifactSet>
                                <includes>
                                    <include>net.gravijet.pluginupdater:core</include>
                                    <include>com.google.code.gson:gson</include>
                                    <include>org.yaml:snakeyaml</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>net.gravijet.pluginupdater.shaded.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>net.gravijet.pluginupdater.shaded.snakeyaml</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <!-- Strip signing metadata and plugin descriptors from
                                     shaded dependencies only. Scoping by groupId:artifactId
                                     keeps the primary artifact's own plugin.yml intact. -->
                                <filter>
                                    <artifact>com.google.code.gson:gson</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.yaml:snakeyaml</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>plugin.yml</exclude>
                                        <exclude>bungee.yml</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>net.gravijet.pluginupdater:core</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
