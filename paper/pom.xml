<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.gravijet.pluginupdater</groupId>
        <artifactId>PluginUpdater</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>paper</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Core shared logic (will be shaded into this JAR) -->
        <dependency>
            <groupId>net.gravijet.pluginupdater</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <scope>compile</scope>
        </dependency>

        <!--
            Spigot API 1.8.8 — used for compilation only (provided at runtime by the server).
            We only use standard Bukkit/Spigot APIs (JavaPlugin, getFile(), etc.) so this
            is fully compatible with custom Paper 1.8.8 forks at runtime.
            Hosted on SpigotMC Nexus (publicly available, works in GitHub Actions).
        -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Paper already bundles Gson and SnakeYAML.
            Declare them as "provided" so the compiler can resolve core's
            transitive references without shading duplicates into the fat JAR.
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Only shade the core module; Paper provides Gson + SnakeYAML -->
                            <artifactSet>
                                <includes>
                                    <include>net.gravijet.pluginupdater:core</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
